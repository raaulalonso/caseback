{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "–" : {
      "comment" : "A placeholder text that appears when a value is unavailable.",
      "isCommentAutoGenerated" : true
    },
    "—" : {
      "comment" : "A placeholder for a widget that shows \"—\" instead of a score.",
      "isCommentAutoGenerated" : true
    },
    "/ %lld" : {
      "comment" : "A slash that separates the two parts of a ratio.",
      "isCommentAutoGenerated" : true
    },
    "%" : {
      "comment" : "A unit of measurement for battery percentage.",
      "isCommentAutoGenerated" : true
    },
    "%@ · %@" : {
      "comment" : "A sublabel that shows how long the night was, and how much longer or shorter it was than your usual average.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "A label displaying the sleep value, formatted as a number followed by the name of the sleep unit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ dBm" : {
      "comment" : "A label showing the signal strength of a nearby device. The argument is the signal strength in dBm.",
      "isCommentAutoGenerated" : true
    },
    "%@ h" : {
      "comment" : "A text label displaying an hour of the day.",
      "isCommentAutoGenerated" : true
    },
    "%@, %@" : {
      "comment" : "A row in the device screen, with a title and a value. The first argument is the title. The second argument is the value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %lld / %lld" : {
      "comment" : "A label that combines the name of the part with the points it earned and the total points possible.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$lld / %3$lld"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A number below the heart rate line, indicating the BPM.",
      "isCommentAutoGenerated" : true
    },
    "%lld %%" : {
      "comment" : "A percentage displayed as a small number in a mono-spaced font.",
      "isCommentAutoGenerated" : true
    },
    "%lld/7" : {
      "comment" : "A score view for the \"Readiness\" metric, showing the current day of recovery calibration. The argument is the current day of recovery calibration (0 for the first day, 6 for the seventh).",
      "isCommentAutoGenerated" : true
    },
