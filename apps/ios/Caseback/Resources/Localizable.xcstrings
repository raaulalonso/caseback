    "detail.affects.hrv.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It changes a lot from one night to the next: look at the trend, not at one night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia mucho de una noche a otra: mira la tendencia, no una noche."
          }
        }
      }
    },
    "detail.affects.hrv.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress, alcohol, illness and little sleep usually lower it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estrés, el alcohol, la enfermedad y dormir poco suelen bajarla."
          }
        }
      }
    },
    "detail.affects.hrv.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is only measured while you are still, so it needs a night of sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se mide con el cuerpo quieto, por eso necesita una noche de sueño."
          }
        }
      }
    },
    "detail.affects.pulse.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Movement, coffee, stress and heat raise it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento, el café, el estrés y el calor lo suben."
          }
        }
      }
    },
    "detail.affects.pulse.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you are doing: walking, sitting or sleeping changes how fast it beats."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que estés haciendo: caminar, estar sentado o dormir cambia cuánto late."
          }
        }
      }
    },
    "detail.affects.pulse.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The time of day: it is usually lowest in the early hours and higher in the afternoon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora del día: suele ser más bajo de madrugada y más alto por la tarde."
          }
        }
      }
    },
    "detail.affects.readiness.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How well and how long you slept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo y cuánto has dormido."
          }
        }
      }
    },
    "detail.affects.readiness.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your HRV and resting heart rate during the night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu HRV y tu pulso en reposo durante la noche."
          }
        }
      }
    },
    "detail.affects.readiness.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A skin warmer or cooler than usual, once there is a reference."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una piel más caliente o más fría de lo habitual, cuando ya hay referencia."
          }
        }
      }
    },
    "detail.affects.restingHR.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poor sleep, illness or stress can raise it for a few days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormir mal, estar enfermo o el estrés pueden subirlo unos días."
          }
        }
      }
    },
    "detail.affects.restingHR.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular exercise tends to lower it over weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ejercicio regular suele bajarlo a lo largo de semanas."
          }
        }
      }
    },
    "detail.affects.restingHR.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcohol and late meals usually raise it that night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El alcohol y las cenas tardías suelen subirlo esa noche."
          }
        }
      }
    },
    "detail.affects.skinTemp.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training late or a heavy dinner usually raises it a little that night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenar tarde o cenar fuerte suele subirla un poco esa noche."
          }
        }
      }
    },
    "detail.affects.skinTemp.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A warm bedroom, heavy bedding or the watch strap can change it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cuarto caluroso, ropa de cama gruesa o la correa del reloj pueden cambiarla."
          }
        }
      }
    },
    "detail.affects.skinTemp.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illness, alcohol and hormonal cycles can move it for days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La enfermedad, el alcohol y los ciclos hormonales pueden moverla durante días."
          }
        }
      }
    },
    "detail.affects.sleep.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going to bed later or earlier than usual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acostarte más tarde o más pronto de lo habitual."
          }
        }
      }
    },
    "detail.affects.sleep.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcohol, a late meal or a warm room can make it lighter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El alcohol, una cena tardía o un cuarto caluroso pueden hacerlo más ligero."
          }
        }
      }
    },
    "detail.affects.sleep.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going to bed at similar times makes your normal steadier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acostarte a horas parecidas hace tu normal más estable."
          }
        }
      }
    },
    "detail.affects.spo2.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude: the higher you are, the lower it usually is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La altitud: cuanto más alto estás, más baja suele ser."
          }
        }
      }
    },
    "detail.affects.spo2.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cold or a blocked nose can move it for a few nights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un resfriado o la nariz congestionada pueden moverla unas noches."
          }
        }
      }
    },
    "detail.affects.spo2.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How you sleep: position or breathing through the mouth can change it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo duermes: la postura o respirar por la boca pueden cambiarla."
          }
        }
      }
    },
    "detail.affects.steps.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether you wear the watch all day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si llevas el reloj puesto todo el día."
          }
        }
      }
    },
    "detail.affects.steps.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days on the move or at a desk change it a lot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días de mucho movimiento o de mesa lo cambian mucho."
          }
        }
      }
    },
    "detail.affects.steps.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether you went out for a walk or a run today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hoy has salido a caminar o a correr."
          }
        }
      }
    },
    "detail.caveat.hrv" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured only while you are still, during sleep. One night says little; the trend says more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se mide con el cuerpo quieto, durante el sueño. Una noche dice poco; la tendencia dice más."
          }
        }
      }
    },
    "detail.caveat.pulse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disc reads when the wrist is still enough, so busy hours have gaps, and a loose watch makes the readings less reliable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco lee cuando la muñeca está bastante quieta, así que las horas con mucho movimiento tienen huecos, y un reloj flojo hace las lecturas menos fiables."
          }
        }
      }
    },
    "detail.caveat.readiness" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A score of ours, built from your sleep, HRV, resting heart rate and skin temperature. Its zones are not validated thresholds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una puntuación nuestra, hecha con tu sueño, tu HRV, tu pulso en reposo y la temperatura de la piel. Sus zonas no son umbrales validados."
          }
        }
      }
    },
    "detail.caveat.restingHR" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured while you sleep. A loose watch can leave nights without a value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mide mientras duermes. Un reloj flojo puede dejar noches sin valor."
          }
        }
      }
    },
    "detail.caveat.skinTemp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows how far your skin is from your usual, not your body temperature. It is a trend and it is not validated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra cuánto se aleja tu piel de lo habitual, no la temperatura de tu cuerpo. Es una tendencia y no está validada."
          }
        }
      }
    },
    "detail.caveat.sleep" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The score is a design of ours, not a validated one. Stages are estimated from heart rate and movement, and a loose disc can leave gaps in the night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puntuación es un diseño nuestro, no validado. Las fases se estiman con el pulso y el movimiento, y un disco flojo puede dejar huecos en la noche."
          }
        }
      }
    },
    "detail.caveat.spo2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It can fail if the watch is loose, with cold hands or while moving. If something worries you, talk to a professional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede fallar si el reloj está flojo, con las manos frías o en movimiento. Si algo te preocupa, consulta con un profesional."
          }
        }
      }
    },
    "detail.caveat.steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counted from wrist movement, so carrying something or pushing a stroller can add or hide some."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cuentan con el movimiento de la muñeca, así que llevar algo en la mano o empujar un carrito puede sumar o restar algunos."
          }
        }
      }
    },
