    "trends.info.band" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The faint band is your usual range: the middle half of your last 30 days, and the dotted line is your median. Drag a finger across the chart to read each day. A gap means there was no value that day; it is never filled in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La banda tenue es tu rango habitual: la mitad central de tus últimos 30 días, y la línea de puntos es tu mediana. Arrastra un dedo por el gráfico para leer cada día. Un hueco significa que ese día no hubo valor; nunca se rellena."
          }
        }
      }
    },
    "trends.info.zones.recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dotted lines are the limits of the zones: low under 33, moderate from 33 to 66 and high from 67. It is a design score that compares you with your own usual, not a medical measurement. Drag a finger across the chart to read each day; a gap means there was no score that day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas de puntos son los límites de las zonas: baja por debajo de 33, moderada de 33 a 66 y alta desde 67. Es una puntuación de diseño que te compara con tu propia normalidad, no una medición médica. Arrastra un dedo por el gráfico para leer cada día; un hueco significa que ese día no hubo puntuación."
          }
        }
      }
    },
    "trends.info.zones.sleep" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dotted lines are the limits of the zones: poor under 60, fair from 60 to 79 and good from 80. The score weighs the hours slept against 8 h, how much of the time in bed you slept, and the share of deep and REM sleep. It is a design score, not a sleep study. Drag a finger across the chart to read each day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las líneas de puntos son los límites de las zonas: mala por debajo de 60, regular de 60 a 79 y buena desde 80. La puntuación pesa las horas dormidas frente a 8 h, cuánto del tiempo en cama dormiste y la parte de sueño profundo y REM. Es una puntuación de diseño, no un estudio del sueño. Arrastra un dedo por el gráfico para leer cada día."
          }
        }
      }
    },
