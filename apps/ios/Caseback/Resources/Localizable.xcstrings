    "today.info.readiness.read" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It weighs HRV (35%), resting heart rate (30%), sleep (25%) and skin temperature (10%). Each bar shows how far that signal is from your normal. It needs 7 nights of data to start and it is not a medical measurement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesa la HRV (35 %), el pulso en reposo (30 %), el sueño (25 %) y la temperatura de la piel (10 %). Cada barra muestra lo lejos que está esa señal de tu normal. Necesita 7 noches de datos para empezar y no es una medición médica."
          }
        }
      }
    },
    "today.info.readiness.what" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
