      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blue is last night's sleep and the white line is now. An hour with no bar had no reliable reading; it is never filled in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El azul es el sueño de anoche y la línea blanca es ahora. Una hora sin barra no tuvo una lectura fiable; nunca se rellena."
          }
        }
      }
    },
    "today.info.day.what" : {
      "extractionState" : "manual",
